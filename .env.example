# --- database (the WordPress/WooCommerce one when running alongside) ---
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress
MYSQL_ROOT_PASSWORD=root
WP_TABLE_PREFIX=wp_

# --- security ---
# openssl rand -base64 48
JWT_SECRET=changeit
# bcrypt = WordPress >= 6.8 hash format; phpass for older WordPress sharing the DB
GOOCOMMERCE_PASSWORD_HASH=bcrypt
# auto (WooCommerce behaviour), email (confirmation link) or admin (approval)
GOOCOMMERCE_ACTIVATION_MODE=auto

# --- URLs ---
GOOCOMMERCE_API_URL=http://localhost:8080
GOOCOMMERCE_UI_URL=http://localhost:3000
GOOCOMMERCE_SHOP_URL=http://localhost:3000
GOOCOMMERCE_UI_INTERNAL_URL=http://ui
GOOCOMMERCE_CORS_ENABLED=true
GOOCOMMERCE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- uploads: mount WordPress' wp-content/uploads here to share images ---
GOOCOMMERCE_UPLOADS_DIR=/uploads
# Public URL of that folder (e.g. https://myshop.com/wp-content/uploads); empty = served by the API at /v1/media
GOOCOMMERCE_UPLOADS_URL=

# --- API only: goocommerce as an AI agent next to an unchanged WooCommerce ---
GOOCOMMERCE_API_ONLY=false

# --- Google sign-in (OIDC) ---
GOOCOMMERCE_OIDC_GOOGLE_CLIENT_ID=
GOOCOMMERCE_OIDC_GOOGLE_CLIENT_SECRET=

# --- CWCloud: emails (customer emails, password reset) and contact form ---
CWCLOUD_API_URL=https://api.cwcloud.tech
CWCLOUD_API_KEY=
CWCLOUD_CONTACT_FORM_ID=
GOOCOMMERCE_MAIL_FROM=noreply@cwcloud.tech

# --- observability ---
# Discord webhook "{id}/{token}" (blank or changeit = disabled)
DISCORD_TOKEN=changeit
# OTLP collector, e.g. otel-collector:4317 (traces, logs and metrics)
GOOCOMMERCE_OTEL_ENDPOINT=
GOOCOMMERCE_OTEL_PROTO=otlp/grpc
