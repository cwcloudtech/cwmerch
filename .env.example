# --- database (the WordPress/WooCommerce one when running alongside) ---
# mysql (also: mariadb, my) or postgres (also: postgresql, pgsql, pg, psql).
# PostgreSQL is for new projects (WordPress itself only runs on MySQL/MariaDB);
# with docker compose also set COMPOSE_PROFILES=postgres.
DB_TYPE=mysql
COMPOSE_PROFILES=mysql
DB_HOST=db
# empty = 3306 for MySQL/MariaDB, 5432 for PostgreSQL
DB_PORT=
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
# WordPress' $table_prefix
DB_TABLE_PREFIX=wp_
# PostgreSQL only: disable, prefer, require, verify-full
DB_SSLMODE=disable
MYSQL_ROOT_PASSWORD=root

# --- security ---
# openssl rand -base64 48
JWT_SECRET=changeit
# bcrypt = WordPress >= 6.8 hash format; phpass for older WordPress sharing the DB
CWMERCH_PASSWORD_HASH=bcrypt
# auto (WooCommerce behaviour), email (confirmation link) or admin (approval)
CWMERCH_ACTIVATION_MODE=auto

# Seals payment providers' credentials stored from the administration
# (openssl rand -base64 32). Without it, credentials can only come from the
# environment variables below.
CWMERCH_SECRET_KEY=

# --- URLs ---
CWMERCH_API_URL=http://localhost:8080
CWMERCH_UI_URL=http://localhost:3000
CWMERCH_SHOP_URL=http://localhost:3000
CWMERCH_UI_INTERNAL_URL=http://ui
CWMERCH_CORS_ENABLED=true
CWMERCH_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- uploads: mount WordPress' wp-content/uploads here to share images ---
CWMERCH_UPLOADS_DIR=/uploads
# Public URL of that folder (e.g. https://myshop.com/wp-content/uploads); empty = served by the API at /v1/media
CWMERCH_UPLOADS_URL=

# --- API only: cwmerch as an AI agent next to an unchanged WooCommerce ---
CWMERCH_API_ONLY=false

# --- Google sign-in (OIDC) ---
CWMERCH_OIDC_GOOGLE_CLIENT_ID=
CWMERCH_OIDC_GOOGLE_CLIENT_SECRET=

# --- CWCloud: emails (customer emails, password reset) and contact form ---
CWCLOUD_API_URL=https://api.cwcloud.tech
CWCLOUD_API_KEY=
CWCLOUD_CONTACT_FORM_ID=
CWMERCH_MAIL_FROM=noreply@cwcloud.tech

# --- observability ---
# Discord webhook "{id}/{token}" (blank or changeit = disabled)
DISCORD_TOKEN=changeit
# OTLP collector, e.g. otel-collector:4317 (traces, logs and metrics)
CWMERCH_OTEL_ENDPOINT=
CWMERCH_OTEL_PROTO=otlp/grpc

# --- online payments (optional: prefer the administration screens) ---
# Environment fallbacks used when nothing is stored in the administration.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# test (sandbox) or live
KONNECT_MODE=test
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=
